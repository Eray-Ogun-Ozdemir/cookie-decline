{
  "name": "cerez-reddet",
  "version": "0.2.0",
  "private": true,
  "description": "Çerez bildirimlerindeki açık ret seçeneklerini uygulayan Chrome eklentisi.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "demo": "node scripts/demo.mjs",
    "preview": "node scripts/demo.mjs --preview",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
