{
  "manifest_version": 3,
  "name": "Çerez Reddet",
  "version": "0.2.1",
  "description": "Tanınan çerez tercihlerini reddeder, site içindeki bildirim isteklerini erteler. Türkçe, İngilizce ve Almanca.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Çerez Reddet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
