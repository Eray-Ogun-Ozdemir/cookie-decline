{
  "manifest_version": 3,
  "name": "Çerez Reddet",
  "version": "0.1.0",
  "description": "Desteklenen çerez bildirimlerindeki açık reddetme seçeneklerine otomatik tıklar. Türkçe, İngilizce ve Almanca.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Çerez Reddet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
